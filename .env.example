# 仅供示例，真实密钥写入服务器 .env，禁止提交仓库
APP_ENCRYPTION_KEY=
ADMIN_API_TOKEN=
REDIS_URL=redis://redis:6379/0
DATA_DIR=/app/data
# 飞书 OAuth 登录的 HTTPS 回调地址（需与飞书应用安全设置完全一致）
FEISHU_LOGIN_REDIRECT_URI=https://zabbix.example.internal/api/v1/auth/callback
WEB_PROTOCOL=https
WEB_PUBLIC_HOST=zabbix.example.internal
# 允许进入后台的飞书用户 Open ID（多个以逗号分隔）
FEISHU_ADMIN_OPEN_IDS=
# 迁移期可临时启用旧 Token API，完成 OAuth 登录后恢复 false
ALLOW_LEGACY_ADMIN_TOKEN=false


ZABBIX_FRONTEND_URL=https://zabbix.example.internal
